# Copy to contracts/.env. Never commit the copy. Never paste PRIVATE_KEY into chat.
PRIVATE_KEY=

# Admin is the wallet that broadcasts. Must match PRIVATE_KEY. Immutable.
# Leave empty to use the PRIVATE_KEY address.
ETHBID_ADMIN=

# Receives RankingRound.sweepToTreasury after a round is finalized.
ETHBID_TREASURY=

# Arbitrum Sepolia. Paxos USDG is the bid asset. Uniswap v3 SwapRouter02 is wired for later.
# https://docs.paxos.com/guides/stablecoin/usdg/testnet
# https://developers.uniswap.org/docs/protocols/v3/deployments/v3-arbitrum-deployments
ETHBID_USDC=0xFFC95faa3d63Cde504a05B567C600B78C0b41892
ETHBID_WETH=0x980B62Da83eFF3D4576C647993b0c1D7faf17c73
ETHBID_SWAP_ROUTER=0x101F443B4d1b059569D643917553c771E1b9663E
ETH_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ETHBID_RANKING=0x3cC438F47c330AB747cf5404c573156221beD2fD
ARBISCAN_API_KEY=

# Round must still be live through judging (2026-10-12). 30 days.
ETHBID_ROUND_DURATION=2592000

