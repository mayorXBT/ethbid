# Copy to contracts/.env. Never commit the copy. Never paste PRIVATE_KEY into chat.
PRIVATE_KEY=

# Admin is the wallet that broadcasts. Must match PRIVATE_KEY. Immutable.
# Leave empty to use the PRIVATE_KEY address.
ETHBID_ADMIN=

# Receives RankingRound.sweepToTreasury after a round is finalized.
ETHBID_TREASURY=

# Round length in seconds. Default 604800 (7 days).
ETHBID_ROUND_DURATION=604800

# Ethereum mainnet. Official Uniswap v3 + Circle USDC.
# https://developers.uniswap.org/contracts/v3/reference/deployments/ethereum-deployments
# https://developers.circle.com/stablecoins/usdc-contract-addresses
ETHBID_USDC=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
ETHBID_WETH=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
ETHBID_SWAP_ROUTER=0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

