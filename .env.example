NEXT_PUBLIC_SITE_URL=https://longbid.lol
NEXT_PUBLIC_BIDS_ENABLED=false

# Hosted Supabase (no Docker). Dashboard → Settings → API / Database.
# Keep these non-sensitive on Vercel so Next can inline them at build.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Must be the service_role JWT or sb_secret_ key from Dashboard → API.
# The publishable/anon key cannot insert bids (RLS). Never put this in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Server-only Crossmint secret. Never use NEXT_PUBLIC_ — the browser must not see this key.
# Scopes: wallets.create, wallets.read, wallets:balance.read
# No collection ID, no contract, no NFT. Rank settles when USDC lands on the deposit wallet.
CROSSMINT_API_KEY=
CROSSMINT_WEBHOOK_SECRET=
# Legacy signer for existing email-authorized wallets only. New wallets use the server signer below.
CROSSMINT_SIGNER_EMAIL=
# 64 hex characters (or xmsk1_<64 hex characters>). Keep server-only and never expose it to the browser.
CROSSMINT_SIGNER_SECRET=
# Your wallets. After a bid pays, we try to sweep USDC here.
CROSSMINT_TREASURY_EVM=
CROSSMINT_TREASURY_SOL=

# Payment provider: keep Crossmint as the fallback; set to moonpay to use Commerce charges.
PAYMENT_PROVIDER=crossmint
# MoonPay Commerce test credentials. The public key identifies the account;
# the API key is the server-only secret used in the Bearer header.
MOONPAY_API_KEY=
MOONPAY_PUBLIC_KEY=
MOONPAY_WEBHOOK_SECRET=
MOONPAY_PAYLINK_ID=
MOONPAY_API_BASE_URL=https://api.dev.hel.io/v1

# ETHBid. The Graph (leaderboard). Do not put ranking in Supabase.
GRAPH_SUBGRAPH_URL=
GRAPH_API_KEY=

# ETHBid contracts. Leave empty until deploy. Then pin addresses here.
# Admin/treasury are not public env. Set them in the RankingRound constructor / setTreasury.
# Mainnet. Official Uniswap SwapRouter02 and Circle USDC (see contracts/.env.example).
NEXT_PUBLIC_ETHBID_CHAIN_ID=1
NEXT_PUBLIC_ETHBID_REGISTRY=0x3cC438F47c330AB747cf5404c573156221beD2fD
NEXT_PUBLIC_ETHBID_RANKING=0xd010E8bdbd492124aF10D2ac3f025beaC2E9D44C
NEXT_PUBLIC_ETHBID_ROUTER=0xD5ed47C1b75D41DFE2de73620C1f496d89861D1D
NEXT_PUBLIC_ETHBID_USDC=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
NEXT_PUBLIC_ETHBID_WETH=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
