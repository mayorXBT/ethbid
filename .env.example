NEXT_PUBLIC_SITE_URL=https://longbid.lol
NEXT_PUBLIC_BIDS_ENABLED=false

# Hosted Supabase (no Docker). Dashboard → Settings → API / Database.
# Keep these non-sensitive on Vercel so Next can inline them at build.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Must be the service_role JWT or sb_secret_ key from Dashboard → API.
# The publishable/anon key cannot insert bids (RLS). Never put this in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Server-only Crossmint secret. Never use NEXT_PUBLIC_ — the browser must not see this key.
# Scopes: wallets.create, wallets.read, wallets:balance.read
# No collection ID, no contract, no NFT. Rank settles when USDC lands on the deposit wallet.
CROSSMINT_API_KEY=
CROSSMINT_WEBHOOK_SECRET=
# Legacy signer for existing email-authorized wallets only. New wallets use the server signer below.
CROSSMINT_SIGNER_EMAIL=
# 64 hex characters (or xmsk1_<64 hex characters>). Keep server-only and never expose it to the browser.
CROSSMINT_SIGNER_SECRET=
# Your wallets. After a bid pays, we try to sweep USDC here.
CROSSMINT_TREASURY_EVM=
CROSSMINT_TREASURY_SOL=
